[Ll]ogs/

# Visual Studio / VS Code / Rider
.vs/
.vscode/
.idea/

# .NET Core / EF
project.lock.json
project.fragment.lock.json
artifacts/
*.nupkg
*.snupkg

# Local secrets and environment files
.env
.env.*
appsettings.Local.json
appsettings.*.Local.json

